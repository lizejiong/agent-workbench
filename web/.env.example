# Server-side development proxy. Model/API keys must never be exposed in VITE_* variables.
KB_BACKEND_ORIGIN=http://127.0.0.1:8080

# Optional login prefill for development AND production builds. These values are public in browser assets.
# Put actual values in ignored .env.local; leave blank to require manual input.
KB_LOGIN_DEFAULT_USERNAME=
KB_LOGIN_DEFAULT_PASSWORD=
