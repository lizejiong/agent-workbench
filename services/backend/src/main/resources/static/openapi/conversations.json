  "components": {
    "schemas": {
      "Create": {
        "type": "object",
        "properties": {
          "requestId": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string",
            "maxLength": 120
          },
          "kbIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "maxItems": 64,
            "nullable": true
          },
          "documentIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "minItems": 1,
            "maxItems": 500,
            "nullable": true
          }
        },
        "required": [
          "requestId"
        ],
        "additionalProperties": false
      },
      "Rename": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "required": [
          "title"
        ],
        "additionalProperties": false
      },
      "Delegate": {
        "type": "object",
        "properties": {
          "serviceId": {
            "type": "string",
            "pattern": "^[a-z0-9-]{1,80}$"
          }
        },
        "required": [
          "serviceId"
        ],
        "additionalProperties": false
      },
      "Begin": {
        "type": "object",
        "properties": {
          "requestId": {
            "type": "string",
            "format": "uuid"
          },
          "messageId": {
            "type": "string",
            "format": "uuid"
          },
          "question": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "deadline": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "requestId",
          "messageId",
          "question",
          "deadline"
        ],
        "additionalProperties": false
      },
      "Snapshot": {
        "type": "object",
        "properties": {
          "evidenceId": {
            "type": "string",
            "pattern": "^K[a-f0-9]{32}_E[1-9][0-9]{0,3}$"
          },
          "kbId": {
            "type": "string",
            "format": "uuid"
          },
          "documentId": {
            "type": "string",
            "format": "uuid"
          },
          "chunkId": {
            "type": "string",
            "format": "uuid"
          },
          "generation": {
            "type": "integer",
            "minimum": 1
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16384
          },
          "sourceContentHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "snapshotHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "sourceMetadata": {
            "type": "object",
            "maxProperties": 64,
            "nullable": true
          },
          "versions": {
            "type": "object",
            "maxProperties": 64,
            "nullable": true
          },
          "truncated": {
            "type": "boolean"
          },
          "toolTruncated": {
            "type": "boolean"
          }
        },
        "required": [
          "evidenceId",
          "kbId",
          "documentId",
          "chunkId",
          "generation",
