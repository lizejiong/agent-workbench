# 配置在启动前由秘密管理或进程环境注入；程序不自动读取 .env 文件。
JAVA_RAG_ORIGIN=http://127.0.0.1:8080
RAG_SERVICE_ID=python-agent
RAG_SERVICE_TOKEN=
# 原生 OpenAI Chat Completions 协议且支持工具调用的供应商地址，不是 Java /ai/chat。
AGENT_MODEL_BASE_URL=https://api.openai.com/v1
AGENT_MODEL=
AGENT_MODEL_API_KEY=
# 默认相对于启动目录；生产设置受保护的绝对路径。
AGENT_STATE_DIR=.cache/agent-service
AGENT_TURN_TIMEOUT=60
AGENT_CONCURRENCY=4
# 应用侧上限，须确认不高于实际供应商窗口；不是自动识别出的模型规格。
AGENT_MODEL_PROVIDER=compatible
AGENT_MODEL_CONTEXT_TOKENS=32768
AGENT_MAX_OUTPUT_TOKENS=1024
AGENT_CONTEXT_SAFETY_TOKENS=2048
AGENT_CONTEXT_BYTE_BUDGET=60000
AGENT_CONTEXT_SOFT_RATIO=0.8
AGENT_HISTORY_TURNS=6
AGENT_MAX_MODEL_CALLS=8
AGENT_MAX_TOOL_CALLS=6
AGENT_TOOL_BYTE_BUDGET=4096
# utf8 为保守估计；只有已确认模型分词方式时，才改用 tiktoken 并填写 encoding。
AGENT_TOKEN_COUNTER=utf8
AGENT_TOKEN_ENCODING=

# 先部署Java V13；主模型须支持JSON object。摘要共享本轮总预算，无独立重试。
AGENT_SUMMARY_ENABLED=true
AGENT_SUMMARY_TIMEOUT=10
