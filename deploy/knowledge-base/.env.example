KB_DB_PASSWORD=replace-with-a-random-database-password
KB_USERNAME=kb-admin
KB_PASSWORD=replace-with-a-random-16-to-72-byte-password
KB_TENANT_ID=tenant-local
KB_USER_ID=user-local
# Optional global metrics access for this server-mapped account. No user/role administration is installed.
KB_OPERATOR=false
KB_S3_ACCESS_KEY=replace-with-local-minio-access-key
KB_S3_SECRET_KEY=replace-with-random-minio-secret-password
KB_AI_BASE_URL=http://host.docker.internal:8081
KB_AI_TOKEN=
KB_SEARCH_MAX_TOP_K=50
KB_SEARCH_MAX_KB_IDS=16
KB_SEARCH_MAX_DOCUMENT_IDS=100
KB_SEARCH_MAX_QUERY_CHARS=4000
KB_SEARCH_MODEL_DEADLINE=40s
KB_WORKER_ENABLED=true
KB_WORKER_CONCURRENCY=2
KB_WORKER_MAX_ATTEMPTS=3
KB_WORKER_LEASE=30s
KB_WORKER_HEARTBEAT=5s
KB_GENERATION_CLEANUP_DELAY=10m

KB_MAINTENANCE_MAX_BATCH_IDS=200
KB_MAINTENANCE_MODEL_DEADLINE=40s
KB_DOCUMENT_CLEANUP_LEASE=4m
KB_DOCUMENT_CLEANUP_POLL_DELAY_MS=10000
KB_CLEANUP_MAX_ATTEMPTS=5

KB_PARSE_LOCAL_TIMEOUT=30s
KB_PARSE_CONCURRENCY=2
KB_PARSE_HEAP_MB=256
KB_PARSE_MAX_ROWS=20000
KB_PARSE_MAX_COLUMNS=128
KB_PARSE_MAX_SHEETS=32
KB_PARSE_MAX_PAGES=500
KB_PARSE_MAX_RESULT_BYTES=8388608
KB_IMAGE_MAX_BYTES=2097152
KB_IMAGE_MAX_PIXELS=16777216
KB_MINERU_ENABLED=false
KB_MINERU_BASE_URL=
KB_MINERU_TOKEN=
KB_MINERU_TIMEOUT=90s
KB_MINERU_CONNECT_TIMEOUT=5s
KB_MINERU_CONCURRENCY=1
KB_MINERU_BACKEND=pipeline
KB_MINERU_LANGUAGE=ch
KB_VLM_ENABLED=false
KB_VLM_MODEL=qwen-vision
KB_VLM_MAX_OUTPUT_TOKENS=2048

# Exact approved source hosts; remote importing is disabled until explicitly configured.
KB_REMOTE_ENABLED=false
KB_REMOTE_ALLOWED_HOSTS=
# Internal origins require a separate exact exception; never allow untrusted users to configure this.
KB_REMOTE_TRUSTED_PRIVATE_HOSTS=
KB_REMOTE_ALLOWED_PORTS=443,80
KB_REMOTE_ALLOW_HTTP=false
KB_REMOTE_CONNECT_TIMEOUT=5s
KB_REMOTE_READ_TIMEOUT=10s
KB_REMOTE_DOWNLOAD_TIMEOUT=30s
KB_REMOTE_MAX_REDIRECTS=3
KB_REMOTE_MAX_BYTES=20971520
KB_REMOTE_CONCURRENCY=2
KB_REFRESH_LEASE=45s
KB_REFRESH_DEADLINE=15m
KB_REFRESH_MAX_ATTEMPTS=3
KB_REFRESH_POLL_DELAY_MS=1000
KB_REMOTE_CLEANUP_POLL_DELAY_MS=10000

# Optional full-text profile; keep off for vector-only installations.
KB_KEYWORD_ENABLED=false
KB_ES_IMAGE=docker.elastic.co/elasticsearch/elasticsearch:8.19.17
KB_ES_ENDPOINT=http://elasticsearch:9200
KB_ES_API_KEY=
KB_ES_INDEX=kb-chunks-v1
KB_ES_ANALYZER=cjk
KB_ES_CALL_TIMEOUT=3s
KB_KEYWORD_LEASE=1m
KB_KEYWORD_MAX_SCOPE_DOCUMENTS=2000
KB_KEYWORD_BATCH_SIZE=100
KB_KEYWORD_MAX_ATTEMPTS=5
KB_KEYWORD_POLL_DELAY_MS=1000
KB_RETRIEVAL_STRATEGY=AUTO
KB_RETRIEVAL_CHANNEL_CANDIDATES=50
KB_RETRIEVAL_FUSION_CANDIDATES=20
KB_RETRIEVAL_RRF_CONSTANT=60
KB_RETRIEVAL_VECTOR_WEIGHT=1
KB_RETRIEVAL_KEYWORD_WEIGHT=1
KB_RETRIEVAL_CONCURRENCY=4
KB_RETRIEVAL_VECTOR_TIMEOUT=40s
KB_RETRIEVAL_KEYWORD_TIMEOUT=5s
KB_RERANK_ENABLED=false
KB_RERANK_MODEL=qwen-rerank
KB_RERANK_TIMEOUT=10s
KB_RERANK_MAX_INPUT_CHARS=30000
KB_RERANK_MIN_SCORE=
